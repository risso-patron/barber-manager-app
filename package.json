{
  "name": "orno",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "predeploy": "node scripts/pre-deploy-check.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-env": "node scripts/validate-env.js",
    "security-check": "node scripts/pre-commit-security.js",
    "setup-hooks": "node -e \"const fs = require('fs'); const path = require('path'); const hookPath = path.join('.git', 'hooks', 'pre-commit'); const hookContent = '#!/bin/sh\\nnode scripts/pre-commit-security.js'; fs.mkdirSync(path.dirname(hookPath), { recursive: true }); fs.writeFileSync(hookPath, hookContent, { mode: 0o755 }); console.log('✅ Git hooks configurados');\"",
    "security:supply-chain": "node scripts/supply-chain-audit.js",
    "deps:add:safe": "node scripts/supply-chain-audit.js --preinstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
