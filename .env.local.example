# Supabase Configuration
# Get these values from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Configuration (Optional)
# Get API key from https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Environment Mode
NODE_ENV=development

# ========================================
# PRODUCTION DEPLOYMENT NOTES
# ========================================
# 
# Before deploying to production:
# 
# 1. Update NEXT_PUBLIC_SUPABASE_URL with your production Supabase URL
# 2. Update NEXT_PUBLIC_SUPABASE_ANON_KEY with your production anon key
# 3. Set NEXT_PUBLIC_APP_URL to your production domain
# 4. Set NODE_ENV=production
# 5. For email: Verify your domain in Resend (https://resend.com/domains)
# 6. Update RESEND_FROM_EMAIL with your verified domain email
# 
# Vercel Deployment:
# Add these environment variables in your Vercel project settings:
# https://vercel.com/docs/environment-variables
# 
# Security Checklist:
# - Never commit .env.local to git
# - Rotate keys if accidentally exposed
# - Use different keys for development/production
# - Enable Row Level Security in Supabase
# 
