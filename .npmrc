node-linker=hoisted
shamefully-hoist=true

# Supply chain hardening (2026)
# 1) Prevent automatic lifecycle script execution.
ignore-scripts=true

# 2) Enforce exact versions on add/update (no implicit ranges).
save-exact=true

# 3) Cooldown strategy: block very recent releases (< 3 days).
minimum-release-age=4320

# 4) Restrict dependency build scripts to an explicit allow-list.
strict-dep-builds=true

# Keep this list tight and review regularly.
only-built-dependencies[]=@next/swc-linux-x64-gnu
only-built-dependencies[]=@next/swc-linux-x64-musl
only-built-dependencies[]=esbuild
